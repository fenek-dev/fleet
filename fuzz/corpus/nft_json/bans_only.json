{"nftables": [
{"metainfo": {"version": "1.0.2", "release_name": "Lester Gooch", "json_schema_version": 1}},
{"table": {"family": "inet", "name": "fleet", "handle": 3}},
{"set": {"family": "inet", "name": "banned4", "table": "fleet", "type": "ipv4_addr", "handle": 1, "flags": ["interval", "timeout"], "elem": [{"elem": {"val": "192.0.2.10", "timeout": 3600, "expires": 3412}}, {"elem": {"val": "192.0.2.11", "timeout": 3600, "expires": 100}}, {"elem": {"val": "192.0.2.12", "timeout": 604800, "expires": 5000}}]}},
{"set": {"family": "inet", "name": "banned6", "table": "fleet", "type": "ipv6_addr", "handle": 2, "flags": ["interval", "timeout"]}},
{"set": {"family": "inet", "name": "exempt4", "table": "fleet", "type": "ipv4_addr", "handle": 3, "flags": ["interval", "timeout"], "elem": [{"prefix": {"addr": "10.0.0.0", "len": 8}}]}},
{"set": {"family": "inet", "name": "exempt6", "table": "fleet", "type": "ipv6_addr", "handle": 4, "flags": ["interval", "timeout"]}},
{"chain": {"family": "inet", "table": "fleet", "name": "input", "handle": 5, "type": "filter", "hook": "input", "prio": 0, "policy": "accept"}},
{"chain": {"family": "inet", "table": "fleet", "name": "forward", "handle": 6, "type": "filter", "hook": "forward", "prio": 0, "policy": "accept"}},
{"rule": {"family": "inet", "table": "fleet", "chain": "input", "handle": 7, "comment": "base", "expr": [{"match": {"op": "!=", "left": {"payload": {"protocol": "ip", "field": "saddr"}}, "right": "@exempt4"}}, {"match": {"op": "==", "left": {"payload": {"protocol": "ip", "field": "saddr"}}, "right": "@banned4"}}, {"drop": null}]}},
{"rule": {"family": "inet", "table": "fleet", "chain": "input", "handle": 8, "comment": "base", "expr": [{"match": {"op": "!=", "left": {"payload": {"protocol": "ip6", "field": "saddr"}}, "right": "@exempt6"}}, {"match": {"op": "==", "left": {"payload": {"protocol": "ip6", "field": "saddr"}}, "right": "@banned6"}}, {"drop": null}]}},
{"rule": {"family": "inet", "table": "fleet", "chain": "forward", "handle": 9, "comment": "base", "expr": [{"match": {"op": "!=", "left": {"payload": {"protocol": "ip", "field": "saddr"}}, "right": "@exempt4"}}, {"match": {"op": "==", "left": {"payload": {"protocol": "ip", "field": "saddr"}}, "right": "@banned4"}}, {"drop": null}]}},
{"rule": {"family": "inet", "table": "fleet", "chain": "forward", "handle": 10, "comment": "base", "expr": [{"match": {"op": "!=", "left": {"payload": {"protocol": "ip6", "field": "saddr"}}, "right": "@exempt6"}}, {"match": {"op": "==", "left": {"payload": {"protocol": "ip6", "field": "saddr"}}, "right": "@banned6"}}, {"drop": null}]}}
]}
