#!/bin/sh
# fleet-agent prerm: stop the agent when the package is removed (not on
# upgrade: a running agent is only replaced through agent.update.*).
# `fleet-agent uninstall` has normally stopped and disabled it already.
set -e

case "$1" in
remove)
    if [ -d /run/systemd/system ]; then
        systemctl disable --now fleet-gate.service fleet-exec.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
