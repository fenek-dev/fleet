<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Team-signed builds with iCloud sync (design §7.6). Use instead of
	Fleet.entitlements (CODE_SIGN_ENTITLEMENTS) when signing with a team and
	a provisioning profile that has the iCloud/CloudKit capability and the
	container below. Unsigned or ad-hoc builds keep Fleet.entitlements; the
	app then detects the missing entitlement and syncs locally only.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.fleet.Fleet</string>
	</array>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.fleet.Fleet</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
