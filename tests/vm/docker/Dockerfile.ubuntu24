# Fleet integration test host: Ubuntu 24.04 with systemd as PID 1.
# Same contract as Dockerfile.debian12 (see there for the run flags).
FROM ubuntu:24.04

ENV container=docker \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus libpam-systemd \
        openssh-server sudo nftables tmux procps iproute2 ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY setup-image.sh /usr/local/sbin/fleet-it-setup-image
RUN bash /usr/local/sbin/fleet-it-setup-image && rm /usr/local/sbin/fleet-it-setup-image

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
